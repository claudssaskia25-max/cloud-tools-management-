  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tool Inventory</title>\n<style>\n* {margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif;}\nbody {background:#f0f4f8;padding:12px;}\n.container {background:#fff;max-width:600px;margin:0 auto;padding:16px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);}\nh2 {font-size:18px;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #ddd;}\n.form-group {margin-bottom:10px;}\nlabel {font-size:13px;margin-bottom:3px;display:block;}\ninput,textarea,select {width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;font-size:13px;}\ntextarea {min-height:50px;resize:vertical;}\n.btn {width:100%;padding:9px;border:none;border-radius:4px;font-size:14px;margin:4px 0;cursor:pointer;}\n.btn-primary {background:#2563eb;color:#fff;}\n.btn-secondary {background:#64748b;color:#fff;}\n.btn-edit {background:#f59e0b;color:#fff;padding:5px 8px;font-size:12px;border:none;border-radius:3px;}\n.btn-delete {background:#dc2626;color:#fff;padding:5px 8px;font-size:12px;border-radius:3px;}\n.search-row {display:grid;grid-template-columns:2fr 1fr;gap:10px;margin:12px 0;}\n.report-container {margin-top:12px;padding:10px;background:#f8fafc;border:1px solid #ddd;border-radius:4px;display:none;}\n.checker-input {width:100%;padding:6px;margin:6px 0 10px 0;border:1px solid #ccc;border-radius:3px;font-size:12px;}\n#reportText {width:100%;height:170px;padding:8px;border:1px solid #ccc;border-radius:3px;font-family:monospace;font-size:10px;white-space:pre;overflow-x:auto;}\ntable {width:100%;border-collapse:collapse;margin-top:8px;}\nth,td {padding:8px 6px;text-align:left;border-bottom:1px solid #eee;font-size:12px;}\nth {background:#2563eb;color:#fff;}\n.status {padding:3px 6px;border-radius:10px;font-size:11px;color:#fff;}\n.av {background:#10b981;}\n.in {background:#3b82f6;}\n.rep {background:#f59e0b;}\n.con {background:#ef4444;}\n@media(max-width:480px){.search-row{grid-template-columns:1fr;}}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h2>🔧 Tool Inventory</h2>\n\n<div class=\"form-group\">\n<label>Serial *</label>\n<input type=\"text\" id=\"serial\" placeholder=\"TL-001\">\n</div>\n\n<div class=\"form-group\">\n<label>Name *</label>\n<input type=\"text\" id=\"name\" placeholder=\"Drill\">\n</div>\n\n<div class=\"form-group\">\n<label>Purpose</label>\n<textarea id=\"use\" placeholder=\"Use\"></textarea>\n</div>\n\n<div class=\"form-group\">\n<label>Status</label>\n<select id=\"status\">\n<option value=\"Available\">Available</option>\n<option value=\"In Use\">In Use</option>\n<option value=\"Under Repair\">Repair</option>\n<option value=\"Condemned\">Condemned</option>\n</select>\n</div>\n\n<div class=\"form-group\">\n<label>Remarks</label>\n<textarea id=\"remarks\" placeholder=\"Notes\"></textarea>\n</div>\n\n<button class=\"btn btn-primary\" onclick=\"saveTool()\">💾 Save</button>\n<button class=\"btn btn-secondary\" onclick=\"generateReport()\">📄 Report</button>\n\n<div class=\"report-container\" id=\"reportArea\">\n<h4 style=\"font-size:13px;margin-bottom:4px;\">Report</h4>\n<label style=\"font-size:11px;\">Checker Name:</label>\n<input type=\"text\" id=\"checker\" class=\"checker-input\" placeholder=\"Enter name here...\">\n<textarea id=\"reportText\" readonly></textarea>\n<button class=\"btn btn-primary\" onclick=\"copyReport()\">📋 Copy Report</button>\n</div>\n\n<div class=\"search-row\">\n<div class=\"form-group\">\n<label>Search</label>\n<input type=\"text\" id=\"search\" placeholder=\"Search...\" onkeyup=\"displayTools()\">\n</div>\n<div class=\"form-group\">\n<label>Filter</label>\n<select id=\"filterStatus\" onchange=\"displayTools()\">\n<option value=\"All\">All</option>\n<option value=\"Available\">Available</option>\n<option value=\"In Use\">In Use</option>\n<option value=\"Under Repair\">Repair</option>\n<option value=\"Condemned\">Condemned</option>\n</select>\n</div>\n</div>\n\n<div class=\"table-container\">\n<table>\n<thead>\n<tr><th>Serial</th><th>Name</th><th>Status</th><th>Action</th></tr>\n</thead>\n<tbody id=\"toolTable\"></tbody>\n</table>\n</div>\n</div>\n\n<script>\n// ✅ FULL COMPLETE LIST OF ALL 15 TOOLS\nconst FULL_TOOL_LIST = [\n    {serial: \"000093\", name: \"Fan\", use: \"Air cooling\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000057\", name: \"Label\", use: \"Labeling\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000080\", name: \"Nail gun\", use: \"Nailing\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000051\", name: \"Safety gear\", use: \"PPE\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000077\", name: \"Battery crimper\", use: \"Crimping\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000045\", name: \"Rubber hammer\", use: \"Hammering\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000040\", name: \"Bolt cutter\", use: \"Cutting\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000059\", name: \"Sealant gun\", use: \"Sealing\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000099\", name: \"Heat gun\", use: \"Bending\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000094\", name: \"Sds wire drill\", use: \"Drilling\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000066\", name: \"Grinder\", use: \"Cutting\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000002\", name: \"Wireless drill\", use: \"Drilling\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000004\", name: \"Impact driver\", use: \"Tightening\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000096\", name: \"Wireless drill\", use: \"Drilling\", status: \"In Use\", remarks: \"-\"},\n    {serial: \"000097\", name: \"Grinder\", use: \"Cutting\", status: \"In Use\", remarks: \"-\"}\n];\n\n// ✅ CLEAR OLD DATA & LOAD FULL LIST\nlocalStorage.removeItem(\"tools\");\nlet tools = [...FULL_TOOL_LIST];\nlocalStorage.setItem(\"tools\", JSON.stringify(tools));\n\nlet editIndex = -1;\n\nfunction saveTool() {\nlet serial = document.getElementById(\"serial\").value.trim();\nlet name = document.getElementById(\"name\").value.trim();\nlet use = document.getElementById(\"use\").value.trim();\nlet status = document.getElementById(\"status\").value;\nlet remarks = document.getElementById(\"remarks\").value.trim();\nif(!serial||!name){alert(\"Enter Serial & Name\");return;}\nlet tool = {serial,name,use,status,remarks};\neditIndex===-1?tools.push(tool):tools[editIndex]=tool;\neditIndex=-1;localStorage.setItem(\"tools\",JSON.stringify(tools));clearForm();displayTools();\n}\n\nfunction editTool(i){\nlet t=tools[i];\ndocument.getElementById(\"serial\").value=t.serial;\ndocument.getElementById(\"name\").value=t.name;\ndocument.getElementById(\"use\").value=t.use||\"\";\ndocument.getElementById(\"status\").value=t.status;\ndocument.getElementById(\"remarks\").value=t.remarks||\"\";\neditIndex=i;window.scrollTo({top:0,behavior:\"smooth\"});\n}\n\nfunction deleteTool(i){if(confirm(\"Delete?\")){tools.splice(i,1);localStorage.setItem(\"tools\",JSON.stringify(tools));displayTools();}}\n\nfunction clearForm(){\ndocument.getElementById(\"serial\").value=\"\";document.getElementById(\"name\").value=\"\";\ndocument.getElementById(\"use\").value=\"\";document.getElementById(\"status\").value=\"Available\";\ndocument.getElementById(\"remarks\").value=\"\";\n}\n\nfunction displayTools(){\nlet search=document.getElementById(\"search\").value.toLowerCase();\nlet filter=document.getElementById(\"filterStatus\").value;\nlet html=\"\";\ntools.forEach((t,i)=>{\nif(filter!==\"All\"&&t.status!==filter)return;\nif(t.serial.toLowerCase().includes(search)||t.name.toLowerCase().includes(search)){\nlet cls=t.status===\"Available\"?\"av\":t.status===\"In Use\"?\"in\":t.status===\"Under Repair\"?\"rep\":\"con\";\nhtml+=`<tr>\n<td>${t.serial}</td>\n<td>${t.name}</td>\n<td><span class=\"status ${cls}\">${t.status.replace(\"Under Repair\",\"Repair\")}</span></td>\n<td><button class=\"btn-edit\" onclick=\"editTool(${i})\">Edit</button>\n<button class=\"btn-delete\" onclick=\"deleteTool(${i})\">Del</button></td>\n</tr>`;\n}});\ndocument.getElementById(\"toolTable\").innerHTML=html||`<tr><td colspan=\"4\" style=\"text-align:center;color:#666;\">No tools</td></tr>`;\n}\n\nfunction generateReport(){\nlet now = new Date();\nlet date = now.toLocaleDateString('en-GB');\nlet time = now.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', hour12:true}).toLowerCase();\nlet filter = document.getElementById(\"filterStatus\").value;\nlet checkerName = document.getElementById(\"checker\").value.trim() || \"____________________\";\nlet list = filter === \"All\" ? tools : tools.filter(t => t.status === filter);\nlet total = list.length;\n\nlet report = `==============================\\n`;\nreport += `   TOOL INVENTORY REPORT\\n`;\nreport += `==============================\\n`;\nreport += `Date    : ${date}\\n`;\nreport += `Time    : ${time}\\n`;\nreport += `Filter  : ${filter} | Total: ${total}\\n`;\nreport += `Checker : ${checkerName}\\n`;\nreport += `------------------------------\\n`;\nreport += `S/N | NAME   | USE  | STAT | REMARKS\\n`;\nreport += `------------------------------\\n`;\n\nif(!total){\n    report += `No records found\\n`;\n} else {\n    list.forEach(t => {\n        let s = t.serial.padEnd(6).substring(0,6);\n        let n = t.name.padEnd(7).substring(0,7);\n        let u = (t.use || \"-\").padEnd(5).substring(0,5);\n        let st = t.status.replace(\"Under Repair\",\"Rep\").padEnd(5).substring(0,5);\n        let r = (t.remarks || \"-\").replace(/\\n/g,\" \").substring(0,20);\n        report += `${s}| ${n}| ${u}| ${st}| ${r}\\n`;\n    });\n}\n\nreport += `==============================\\n`;\n\ndocument.getElementById(\"reportText\").value = report;\ndocument.getElementById(\"reportArea\").style.display = \"block\";\ndocument.getElementById(\"reportArea\").scrollIntoView({behavior:\"smooth\"});\n}\n\nfunction copyReport(){\nlet box=document.getElementById(\"reportText\");box.select();box.setSelectionRange(0,99999);document.execCommand(\"copy\");alert(\"✅ Report copied!\");\n}\n\ndisplayTools();\n</script>\n</body>\n</html>\n"
  },
